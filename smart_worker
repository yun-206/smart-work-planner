        <!-- TAB 1: Daily Work Plan & Recommended Leave -->
        <div id="tab1" class="space-y-4">
            
            <!-- Preset Buttons & Guide -->
            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-3 text-xs">
                <div class="flex items-center gap-2">
                    <span class="font-bold text-slate-700 flex items-center gap-1">
                        <i class="fa-solid fa-sliders text-indigo-500"></i> 남은 날 일괄 목표 채우기:
                    </span>
                    <button onclick="applyPreset('8h')" class="bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 px-2.5 py-1.5 rounded-lg border border-slate-200 transition font-medium">매일 8시간 (17:30 퇴근)</button>
                    <button onclick="applyPreset('fri7h')" class="bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 px-2.5 py-1.5 rounded-lg border border-slate-200 transition font-medium">월-목 8.25h + 금 7h (16:30 퇴근)</button>
                </div>
                <div class="flex items-center gap-3 text-slate-500 font-medium">
                    <span class="text-indigo-600 font-bold"><i class="fa-solid fa-circle-info"></i> 코어타임: 월~목(10~16시) / 금(10~12시)</span>
                </div>
            </div>

            <!-- Alerts Container -->
            <div id="alertsContainer" class="space-y-2"></div>

            <!-- Main Work Table -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-slate-100 border-b border-slate-200 text-slate-600 font-semibold">
                                <th class="p-3.5 w-32">날짜 / 구분</th>
                                <th class="p-3.5 w-32">출근 시각</th>
                                <th class="p-3.5 w-32">퇴근 시각</th>
                                <th class="p-3.5 w-48">시차 연차 / 외출 / 병가</th>
                                <th class="p-3.5 w-28">인정 근무시간</th>
                                <th class="p-3.5 w-24">출처</th>
                                <th class="p-3.5 w-48">비고 / 구분</th>
                            </tr>
                        </thead>
                        <tbody id="workTableBody" class="divide-y divide-slate-100">
                            <!-- JS Dynamically Injected -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 2: Vacation Simulation -->
        <div id="tab2" class="hidden space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Vacation Summary -->
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-slate-800 text-base mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-umbrella-beach text-amber-500"></i> 연차 생성 & 사용 현황
                        </h3>
                        <div class="space-y-3">
                            <div class="flex justify-between items-center text-sm border-b pb-2">
                                <span class="text-slate-500">누적 생성 연차</span>
                                <span class="font-bold text-emerald-600" id="totalAccruedVac">1개 (8시간)</span>
                            </div>
                            <div class="flex justify-between items-center text-sm border-b pb-2">
                                <span class="text-slate-500">시뮬레이션 예정 연차</span>
                                <span class="font-bold text-indigo-600" id="simVacHours">0시간</span>
                            </div>
                            <div class="flex justify-between items-center text-base pt-1 font-bold">
                                <span class="text-slate-800">최종 잔여 연차</span>
                                <span class="text-amber-600" id="remVacHours">8시간 (1일)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Simulation Input Form -->
                <div class="md:col-span-2 bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                    <h3 class="font-bold text-slate-800 text-base mb-2">30분 단위 시차 연차 추가</h3>
                    <p class="text-xs text-slate-500 mb-4">원하는 날짜에 30분(0.5시간) 단위로 연차를 분할 등록하여 시뮬레이션 해보세요.</p>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">날짜 선택</label>
                            <input type="date" id="simDate" class="w-full border border-slate-300 rounded-lg p-2 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">연차 구분</label>
                            <select id="simType" onchange="adjustSimHours(this.value)" class="w-full border border-slate-300 rounded-lg p-2 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                                <option value="시차연차">시차연차 (30분 단위 직접지정)</option>
                                <option value="목요일 코어타임">목요일 코어타임 (6시간)</option>
                                <option value="금요일 코어타임">금요일 코어타임 (2시간)</option>
                                <option value="종일연차">종일연차 (8시간)</option>
                                <option value="오전반차">오전반차 (4시간)</option>
                                <option value="오후반차">오후반차 (4시간)</option>
                                <option value="병가">병가 (최대 2시간)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">사용 시간 (시간)</label>
                            <input type="number" id="simHours" value="0.5" min="0.5" max="8" step="0.5" class="w-full border border-slate-300 rounded-lg p-2 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                        </div>
                    </div>
                    <button onclick="addVacationSim()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs py-2.5 rounded-lg transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-plus"></i> 시뮬레이션 목록에 추가하기
                    </button>
                </div>
            </div>

            <!-- Vacation List Table -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-4 border-b border-slate-200 font-bold text-sm text-slate-800 flex justify-between items-center">
                    <span>계획된 연차 목록</span>
                    <button onclick="clearSimVacations()" class="text-xs text-rose-500 hover:underline font-normal">시뮬레이션 전체 삭제</button>
                </div>
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-slate-100 text-slate-600 font-semibold border-b border-slate-200">
                            <th class="p-3">날짜</th>
                            <th class="p-3">구분</th>
                            <th class="p-3">차감 시간</th>
                            <th class="p-3">상태</th>
                            <th class="p-3 text-center">관리</th>
                        </tr>
                    </thead>
                    <tbody id="vacationTableBody" class="divide-y divide-slate-100">
                        <!-- JS Dynamically Injected -->
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <script>
        function getTodayString() {
            const now = new Date();
            const y = now.getFullYear();
            const m = String(now.getMonth() + 1).padStart(2, '0');
            const d = String(now.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        let currentMonth = 9;
        let daysDataMap = {};
        let simVacations = [];
        let excelUploaded = false;

        const HOLIDAYS = {
            9: [24, 25],     // 추석 연휴
            10: [5, 9],      // 개천절 대체휴일, 한글날
            11: []           
        };

        window.addEventListener('DOMContentLoaded', () => {
            loadFromLocalStorage();
            if (!daysDataMap[9]) generateMonthData(2026, 9);
            if (!daysDataMap[10]) generateMonthData(2026, 10);
            if (!daysDataMap[11]) generateMonthData(2026, 11);
            
            renderTable();
            updateSummary();
        });

        function changeMonth(monthVal) {
            currentMonth = parseInt(monthVal);
            document.getElementById('bgMonthNum').innerText = currentMonth;
            renderTable();
            updateSummary();
        }

        function generateMonthData(year, month) {
            let list = [];
            const daysInMonth = new Date(year, month, 0).getDate();
            for (let d = 1; d <= daysInMonth; d++) {
                const dateObj = new Date(year, month - 1, d);
                const dayNum = dateObj.getDay();
                const dayStr = ['일', '월', '화', '수', '목', '금', '토'][dayNum];
                const fullDateStr = `${year}-${String(month).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                
                let isHoliday = (dayNum === 0 || dayNum === 6);
                if (HOLIDAYS[month] && HOLIDAYS[month].includes(d)) {
                    isHoliday = true;
                }

                let isEndAfter = false;
                if (month === 11 && d > 23) {
                    isHoliday = true;
                    isEndAfter = true;
                }

                list.push({
                    date: fullDateStr,
                    dayLabel: `${d}일 (${dayStr})`,
                    dayOfWeek: dayStr,
                    dayNumber: d,
                    isHoliday: isHoliday,
                    isEndAfter: isEndAfter,
                    inTime: '',
                    outTime: '',
                    vacationHours: 0,
                    outHours: 0,
                    tripHours: 0,
                    workedHours: '0:00',
                    source: 'plan',
                    note: isEndAfter ? '인턴만료 종료' : ''
                });
            }
            daysDataMap[month] = list;
        }

        function parseTimeToMinutes(t) {
            if (!t || typeof t !== 'string' || !t.includes(':')) return 0;
            const [h, m] = t.split(':').map(Number);
            return (h * 60) + (m || 0);
        }

        function formatMinutesToHM(mins) {
            if (isNaN(mins) || mins < 0) mins = 0;
            const h = Math.floor(mins / 60);
            const m = mins % 60;
            return `${h}:${String(m).padStart(2, '0')}`;
        }

        function handleFileSelect(e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(event) {
                try {
                    const data = new Uint8Array(event.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const sheet = workbook.Sheets[workbook.SheetNames[0]];
                    const json = XLSX.utils.sheet_to_json(sheet, { header: 1 });

                    processCompanyExcel(json);
                    excelUploaded = true;
                    document.getElementById('fileInfo').classList.remove('hidden');
                    document.getElementById('fileName').innerText = file.name;
                    saveToLocalStorage();
                    renderTable();
                    updateSummary();
                } catch (err) {
                    alert('엑셀 파일을 읽는 도중 오류가 발생했습니다.');
                    console.error(err);
                }
            };
            reader.readAsArrayBuffer(file);
        }

        function processCompanyExcel(rows) {
            rows.forEach(row => {
                if (!row || row.length < 10) return;
                const dateStr = String(row[6] || '').trim();
                if (dateStr.match(/^\d{4}-\d{2}-\d{2}$/)) {
                    const m = parseInt(dateStr.split('-')[1]);
                    if (daysDataMap[m]) {
                        const matchedDay = daysDataMap[m].find(d => d.date === dateStr);
                        if (matchedDay) {
                            const inVal = String(row[7] || '').trim();
                            const outVal = String(row[9] || '').trim();
                            const calcWorked = String(row[16] || '').trim();
                            const isHol = String(row[5] || '').trim() !== '평일';
                            
                            const tripTime = String(row[22] || '').trim();
                            const leaveTime = String(row[25] || '').trim();
                            const reason = String(row[45] || '').trim();

                            matchedDay.inTime = (inVal && inVal.length === 5) ? inVal : '';
                            matchedDay.outTime = (outVal && outVal.length === 5) ? outVal : '';
                            matchedDay.isHoliday = isHol || matchedDay.isEndAfter;
                            matchedDay.source = 'system';

                            let noteList = [];

                            if (tripTime && tripTime !== '\xa0' && tripTime.includes(':')) {
                                const tMins = parseTimeToMinutes(tripTime);
                                matchedDay.tripHours = tMins / 60;
                                noteList.push(`출장 ${tripTime}`);
                            }

                            if (leaveTime && leaveTime !== '\xa0' && leaveTime.includes(':')) {
                                const lMins = parseTimeToMinutes(leaveTime);
                                matchedDay.outHours = lMins / 60;
                                const rText = reason ? ` (${reason.split(' ')[0]})` : '';
                                noteList.push(`외출/병가 ${leaveTime}${rText}`);
                            }

                            matchedDay.note = matchedDay.isEndAfter ? '인턴만료 종료' : noteList.join(', ');

                            if (calcWorked && calcWorked.includes(':')) {
                                matchedDay.workedHours = calcWorked;
                            } else if (matchedDay.tripHours > 0) {
                                matchedDay.workedHours = formatMinutesToHM(matchedDay.tripHours * 60);
                            } else {
                                matchedDay.workedHours = '0:00';
                            }
                        }
                    }
                }
            });
        }

        function clearExcelData() {
            excelUploaded = false;
            document.getElementById('fileInfo').classList.add('hidden');
            document.getElementById('fileInput').value = '';
            generateMonthData(2026, currentMonth);
            saveToLocalStorage();
            renderTable();
            updateSummary();
        }

        function calcDailyWorkedMinutes(day) {
            if (day.isHoliday) return 0;
            if (day.source === 'system' && day.workedHours && day.workedHours !== '0:00') {
                return parseTimeToMinutes(day.workedHours);
            }
            
            let totalMins = 0;

            if (day.inTime && day.outTime) {
                const startMins = parseTimeToMinutes(day.inTime);
                const endMins = parseTimeToMinutes(day.outTime);
                totalMins = endMins - startMins;

                if (startMins < 720 && endMins > 780) {
                    totalMins -= 60;
                }
            }

            const simForDay = simVacations.filter(v => v.date === day.date);
            let simVacMins = 0;
            simForDay.forEach(v => {
                simVacMins += (v.hours * 60);
            });

            totalMins += simVacMins;
            totalMins += (day.vacationHours || 0) * 60;
            totalMins += (day.tripHours || 0) * 60;

            return Math.max(0, totalMins);
        }

        function renderTable() {
            const todayStr = getTodayString();
            const daysData = daysDataMap[currentMonth] || [];
            const tbody = document.getElementById('workTableBody');
            tbody.innerHTML = '';
            let alerts = [];

            daysData.forEach((day, idx) => {
                const tr = document.createElement('tr');
                tr.className = day.isHoliday ? 'bg-slate-50/80 text-slate-400' : 'hover:bg-indigo-50/20 transition';

                const workedMins = calcDailyWorkedMinutes(day);
                const workedStr = formatMinutesToHM(workedMins);

                let eventBadge = '';
                if (day.dayNumber === 21) {
                    eventBadge = '<span class="text-[10px] bg-amber-100 text-amber-800 font-bold px-1.5 py-0.5 rounded ml-1">💰 월급날</span>';
                } else if (day.dayNumber === 24 && currentMonth !== 11) {
                    eventBadge = '<span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.5 rounded ml-1">🎉 연차 +1개 생성</span>';
                } else if (currentMonth === 11 && day.dayNumber === 23) {
                    eventBadge = '<span class="text-[10px] bg-rose-100 text-rose-800 font-bold px-1.5 py-0.5 rounded ml-1">🎓 인턴 만료 종료일</span>';
                }

                if (!day.isHoliday && day.inTime && day.outTime) {
                    const inM = parseTimeToMinutes(day.inTime);
                    const outM = parseTimeToMinutes(day.outTime);

                    if (day.dayOfWeek === '금') {
                        if (inM > 600 || outM < 720) {
                            alerts.push(`${day.dayLabel}: 금요일 의무 근무시간(10:00 ~ 12:00) 미충족 경고`);
                        }
                    } else {
                        if (inM > 600 || outM < 960) {
                            alerts.push(`${day.dayLabel}: 월~목 의무 근무시간(10:00 ~ 16:00) 미충족 경고`);
                        }
                    }
                }

                let specialBadge = '-';
                const simForDay = simVacations.filter(v => v.date === day.date);
                if (simForDay.length > 0) {
                    const simInfo = simForDay.map(v => `시차연차 ${v.hours}h`).join(', ');
                    specialBadge = `<span class="bg-indigo-50 text-indigo-700 border border-indigo-200 px-2 py-0.5 rounded font-medium text-[11px]">${simInfo}</span>`;
                } else if (day.note) {
                    specialBadge = `<span class="bg-slate-100 text-slate-700 border border-slate-200 px-2 py-0.5 rounded font-medium text-[11px]">${day.note}</span>`;
                }

                const isPastOrToday = day.date <= todayStr;
                let sourceBadge = '<span class="bg-slate-100 text-slate-500 font-bold px-2 py-0.5 rounded text-[10px]">계획</span>';
                
                if (day.source === 'system') {
                    sourceBadge = '<span class="bg-emerald-100 text-emerald-700 font-bold px-2 py-0.5 rounded text-[10px]">✓ 시스템</span>';
                } else if (isPastOrToday && (day.inTime || day.outTime)) {
                    sourceBadge = '<span class="bg-emerald-100 text-emerald-700 font-bold px-2 py-0.5 rounded text-[10px]">✓ 완료</span>';
                }

                tr.innerHTML = `
                    <td class="p-3.5 font-semibold">
                        ${day.dayLabel} 
                        ${day.isHoliday ? `<span class="text-[10px] bg-slate-200 text-slate-600 px-1.5 py-0.5 rounded ml-1">${day.isEndAfter ? '종료' : '휴일'}</span>` : ''}
                        ${eventBadge}
                    </td>
                    <td class="p-3.5">
                        <input type="time" value="${day.inTime}" ${day.isHoliday ? 'disabled' : ''} 
                               onchange="updateRow(${idx}, 'inTime', this.value)"
                               class="border border-slate-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-indigo-500 disabled:bg-slate-100">
                    </td>
                    <td class="p-3.5">
                        <input type="time" value="${day.outTime}" ${day.isHoliday ? 'disabled' : ''} 
                               onchange="updateRow(${idx}, 'outTime', this.value)"
                               class="border border-slate-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-indigo-500 disabled:bg-slate-100">
                    </td>
                    <td class="p-3.5">${specialBadge}</td>
                    <td class="p-3.5 font-bold ${workedMins > 0 ? 'text-indigo-600' : 'text-slate-400'}">
                        ${workedStr}
                    </td>
                    <td class="p-3.5">
                        ${sourceBadge}
                    </td>
                    <td class="p-3.5 text-slate-500">
                        ${day.isEndAfter 
                            ? '<span class="text-[11px] text-slate-400">인턴만료</span>'
                            : `<button onclick="toggleHoliday(${idx})" class="text-[11px] text-indigo-500 hover:underline">
                                ${day.isHoliday ? '평일전환' : '휴일전환'}
                               </button>`}
                    </td>
                `;
                tbody.appendChild(tr);
            });

            const alertBox = document.getElementById('alertsContainer');
            if (alerts.length > 0) {
                alertBox.innerHTML = `
                    <div class="bg-amber-50 border border-amber-200 text-amber-800 p-3 rounded-xl text-xs flex items-center gap-2">
                        <i class="fa-solid fa-triangle-exclamation text-amber-600"></i>
                        <span>${alerts[0]} (총 ${alerts.length}건 규정 체크)</span>
                    </div>
                `;
            } else {
                alertBox.innerHTML = '';
            }
        }

        function updateRow(idx, field, value) {
            daysDataMap[currentMonth][idx][field] = value;
            daysDataMap[currentMonth][idx].source = 'manual';
            saveToLocalStorage();
            renderTable();
            updateSummary();
        }

        function toggleHoliday(idx) {
            daysDataMap[currentMonth][idx].isHoliday = !daysDataMap[currentMonth][idx].isHoliday;
            if (daysDataMap[currentMonth][idx].isHoliday) {
                daysDataMap[currentMonth][idx].inTime = '';
                daysDataMap[currentMonth][idx].outTime = '';
            }
            saveToLocalStorage();
            renderTable();
            updateSummary();
        }

        function updateSummary() {
            const todayStr = getTodayString();
            const daysData = daysDataMap[currentMonth] || [];
            let totalWorkedMins = 0;
            let pastWorkedDaysCount = 0;
            let pastWorkedMins = 0;
            let totalWorkDaysCount = 0;
            let remWorkDays = 0;

            daysData.forEach(d => {
                if (!d.isHoliday) {
                    totalWorkDaysCount++;
                    const m = calcDailyWorkedMinutes(d);
                    totalWorkedMins += m;

                    const isPastOrToday = d.date <= todayStr;
                    const hasActualWorkedTime = m > 0;

                    // ONLY COUNT AS PAST WORKED DAY IF IT ACTUALLY HAS WORKED TIME AND IS PAST/TODAY
                    if (isPastOrToday && hasActualWorkedTime) {
                        pastWorkedDaysCount++;
                        pastWorkedMins += m;
                    } else if (!isPastOrToday || !hasActualWorkedTime) {
                        remWorkDays++;
                    }
                }
            });

            const totalTargetMins = totalWorkDaysCount * 8 * 60; 
            const expectedMinsToDate = pastWorkedDaysCount * 8 * 60; // 8 hours per actual worked past day
            const currentOvertimeMins = pastWorkedMins - expectedMinsToDate; // EXACT REALTIME OVERTIME

            document.getElementById('totalWorked').innerText = formatMinutesToHM(totalWorkedMins);
            document.getElementById('targetWork').innerText = formatMinutesToHM(totalTargetMins);

            const overEl = document.getElementById('currentOvertime');
            if (currentOvertimeMins >= 0) {
                overEl.innerText = `+${formatMinutesToHM(currentOvertimeMins)} 여유`;
                overEl.className = 'text-lg font-bold text-emerald-400';
            } else {
                overEl.innerText = `-${formatMinutesToHM(Math.abs(currentOvertimeMins))} 부족`;
                overEl.className = 'text-lg font-bold text-rose-400';
            }

            const remMinsForMonth = Math.max(0, totalTargetMins - pastWorkedMins);
            document.getElementById('diffWork').innerText = `${formatMinutesToHM(remMinsForMonth)} 필요`;

            if (remWorkDays > 0) {
                const recPerDayMins = Math.ceil(remMinsForMonth / remWorkDays);
                const recLeaveMins = 510 + recPerDayMins;
                const leaveH = Math.floor(recLeaveMins / 60);
                const leaveM = recLeaveMins % 60;
                document.getElementById('recommendTime').innerText = `${String(leaveH).padStart(2, '0')}:${String(leaveM).padStart(2, '0')} (08:30 출근 기준)`;
            } else {
                document.getElementById('recommendTime').innerText = '정산 완료';
            }

            renderVacationTab();
        }

        function applyPreset(type) {
            const daysData = daysDataMap[currentMonth] || [];
            daysData.forEach(d => {
                if (!d.isHoliday && (d.source !== 'system' || !d.workedHours || d.workedHours === '0:00')) {
                    if (type === '8h') {
                        d.inTime = '08:30'; d.outTime = '17:30';
                    } else if (type === 'fri7h') {
                        if (d.dayOfWeek === '금') {
                            d.inTime = '08:30'; d.outTime = '16:30';
                        } else {
                            d.inTime = '08:30'; d.outTime = '17:45';
                        }
                    }
                }
            });
            saveToLocalStorage();
            renderTable();
            updateSummary();
        }

        function adjustSimHours(typeVal) {
            const hInput = document.getElementById('simHours');
            if (typeVal === '목요일 코어타임') hInput.value = 6;
            else if (typeVal === '금요일 코어타임') hInput.value = 2;
            else if (typeVal === '종일연차') hInput.value = 8;
            else if (typeVal === '오전반차' || typeVal === '오후반차') hInput.value = 4;
            else if (typeVal === '병가') hInput.value = 2;
            else hInput.value = 0.5;
        }

        function addVacationSim() {
            const date = document.getElementById('simDate').value;
            const type = document.getElementById('simType').value;
            let hours = parseFloat(document.getElementById('simHours').value) || 0;

            if (!date) {
                alert('날짜를 선택해 주세요.');
                return;
            }

            if (hours % 0.5 !== 0) {
                alert('연차 및 시간차는 30분(0.5시간) 단위로만 신청이 가능합니다.');
                return;
            }

            if (type === '병가' && hours > 2) {
                alert('병가는 일 최대 2시간까지만 인정됩니다. 2시간으로 설정됩니다.');
                hours = 2;
            }

            simVacations.push({ date, type, hours });
            saveToLocalStorage();
            renderTable();
            renderVacationTab();
            updateSummary();
        }

        function clearSimVacations() {
            simVacations = [];
            saveToLocalStorage();
            renderTable();
            renderVacationTab();
            updateSummary();
        }

        function renderVacationTab() {
            const tbody = document.getElementById('vacationTableBody');
            tbody.innerHTML = '';
            let simHoursTotal = 0;

            simVacations.forEach((v, i) => {
                simHoursTotal += v.hours;
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-3 font-semibold">${v.date}</td>
                    <td class="p-3">${v.type}</td>
                    <td class="p-3 font-bold text-amber-600">${v.hours}시간</td>
                    <td class="p-3"><span class="bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded text-[10px]">시뮬레이션</span></td>
                    <td class="p-3 text-center"><button onclick="deleteSimVac(${i})" class="text-rose-500 hover:underline">삭제</button></td>
                `;
                tbody.appendChild(tr);
            });

            let accruedCount = currentMonth - 8; 
            let accruedHours = accruedCount * 8;

            document.getElementById('totalAccruedVac').innerText = `${accruedCount}개 (${accruedHours}시간)`;
            document.getElementById('simVacHours').innerText = `${simHoursTotal}시간`;
            
            const rem = accruedHours - simHoursTotal;
            document.getElementById('remVacHours').innerText = `${rem}시간 (${(rem / 8).toFixed(1)}일)`;
        }

        function deleteSimVac(i) {
            simVacations.splice(i, 1);
            saveToLocalStorage();
            renderTable();
            renderVacationTab();
            updateSummary();
        }

        function switchTab(tab) {
            if (tab === 'tab1') {
                document.getElementById('tab1').classList.remove('hidden');
                document.getElementById('tab2').classList.add('hidden');
                document.getElementById('tab1Btn').className = 'px-5 py-3 font-semibold text-sm border-b-2 border-indigo-600 text-indigo-600 transition flex items-center gap-2';
                document.getElementById('tab2Btn').className = 'px-5 py-3 font-semibold text-sm text-slate-500 hover:text-slate-700 transition flex items-center gap-2';
            } else {
                document.getElementById('tab1').classList.add('hidden');
                document.getElementById('tab2').classList.remove('hidden');
                document.getElementById('tab2Btn').className = 'px-5 py-3 font-semibold text-sm border-b-2 border-indigo-600 text-indigo-600 transition flex items-center gap-2';
                document.getElementById('tab1Btn').className = 'px-5 py-3 font-semibold text-sm text-slate-500 hover:text-slate-700 transition flex items-center gap-2';
            }
        }

        function saveToLocalStorage() {
            localStorage.setItem('work_planner_months', JSON.stringify(daysDataMap));
            localStorage.setItem('work_planner_vacs', JSON.stringify(simVacations));
        }

        function loadFromLocalStorage() {
            const savedMonths = localStorage.getItem('work_planner_months');
            const savedVacs = localStorage.getItem('work_planner_vacs');
            if (savedMonths) daysDataMap = JSON.parse(savedMonths);
            if (savedVacs) simVacations = JSON.parse(savedVacs);
        }

        function resetData() {
            if (confirm('모든 입력 및 데이터가 초기화됩니다.')) {
                localStorage.clear();
                excelUploaded = false;
                simVacations = [];
                daysDataMap = {};
                generateMonthData(2026, 9);
                generateMonthData(2026, 10);
                generateMonthData(2026, 11);
                document.getElementById('fileInfo').classList.add('hidden');
                renderTable();
                updateSummary();
            }
        }

        function shareLink() {
            navigator.clipboard.writeText(window.location.href);
            alert('웹 앱 주소가 클립보드에 복사되었습니다!');
        }
    </script>
</body>
</html>
